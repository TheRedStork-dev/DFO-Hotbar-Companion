<Application x:Class="DfoHotbarCompanion.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Ink" Color="#F2E7CF" />
    <SolidColorBrush x:Key="Muted" Color="#B9AB8C" />
    <SolidColorBrush x:Key="Brass" Color="#D9A441" />
    <SolidColorBrush x:Key="Panel" Color="#171A17" />
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#11140F" />
      <Setter Property="Background" Value="{StaticResource Brass}" />
      <Setter Property="BorderBrush" Value="#F0C96D" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Application.Resources>
</Application>

