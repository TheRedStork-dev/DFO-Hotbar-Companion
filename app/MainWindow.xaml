<Window x:Class="DfoHotbarCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DFO Hotbar Companion" Width="760" Height="570"
        MinWidth="660" MinHeight="470" WindowStartupLocation="CenterScreen"
        Background="#0C0F0C" Foreground="{StaticResource Ink}">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock FontFamily="Georgia" FontSize="34" Foreground="{StaticResource Brass}"
               Text="DFO HOTBAR COMPANION" />
    <TextBlock Grid.Row="1" Margin="0,5,0,18" FontSize="15" Foreground="{StaticResource Muted}"
               Text="Four switchable hotbar pages, rebuilt automatically for the current DFO release." />

    <Border Grid.Row="2" Padding="16" CornerRadius="7" Background="{StaticResource Panel}"
            BorderBrush="#4A422C" BorderThickness="1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="StatusTitle" FontSize="18" FontWeight="SemiBold" Text="Ready" />
          <TextBlock x:Name="StatusDetail" Margin="0,4,16,0" Foreground="{StaticResource Muted}"
                     TextWrapping="Wrap" Text="The first setup can take several minutes. Later updates are automatic." />
        </StackPanel>
        <Button x:Name="UpdateButton" Grid.Column="1" Click="UpdateAndLaunch_Click"
                Content="UPDATE &amp; LAUNCH DFO" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Border Grid.Row="3" Margin="0,16,0,14" Padding="12" CornerRadius="6" Background="#111411"
            BorderBrush="#32372F" BorderThickness="1">
      <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="12" Foreground="#C7D0BF"
                   TextWrapping="Wrap" />
      </ScrollViewer>
    </Border>

    <DockPanel Grid.Row="4">
      <TextBlock Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                 Text="Bind Previous/Next Hotbar Page in DFO Settings › Controls." />
      <Button x:Name="LaunchButton" DockPanel.Dock="Right" Margin="12,0,0,0" Padding="14,7"
              Click="LaunchOnly_Click" Content="LAUNCH WITHOUT UPDATING" />
    </DockPanel>
  </Grid>
</Window>

