<Window x:Class="DfoHotbarCompanion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DFO Companion" Width="1380" Height="860" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#0C0F0C" Foreground="{StaticResource Ink}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Margin="0,0,0,15">
      <StackPanel>
        <TextBlock Text="DFO COMPANION" FontFamily="Georgia" FontSize="32" FontWeight="Bold" Foreground="{StaticResource Brass}"/>
        <TextBlock Text="Live dungeon scanning and switchable hotbars in one app." FontSize="14" Foreground="{StaticResource Muted}"/>
      </StackPanel>
      <Button x:Name="LaunchButton" DockPanel.Dock="Right" Content="UPDATE &amp; LAUNCH DFO" Click="Launch_Click"
              HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="220"/>
    </DockPanel>

    <Grid Grid.Row="1" Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource Panel}" BorderBrush="#4A422C" BorderThickness="1" CornerRadius="7" Padding="14">
        <DockPanel>
          <CheckBox x:Name="ScannerEnabledBox" DockPanel.Dock="Right" Content="Enabled" FontWeight="Bold"
                    VerticalAlignment="Center" Click="ModuleToggle_Click"/>
          <StackPanel>
            <TextBlock Text="DUNGEON SCANNER" Foreground="{StaticResource Brass}" FontWeight="Bold"/>
            <TextBlock x:Name="ScannerModuleStatus" Text="Starts only when enabled" Foreground="{StaticResource Muted}" Margin="0,3,12,0"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="#4A422C" BorderThickness="1" CornerRadius="7" Padding="14">
        <DockPanel>
          <CheckBox x:Name="HotbarEnabledBox" DockPanel.Dock="Right" Content="Enabled" FontWeight="Bold"
                    VerticalAlignment="Center" Click="ModuleToggle_Click"/>
          <StackPanel>
            <TextBlock Text="MULTI-PAGE HOTBAR" Foreground="{StaticResource Brass}" FontWeight="Bold"/>
            <TextBlock x:Name="HotbarModuleStatus" Text="Updates only when enabled" Foreground="{StaticResource Muted}" Margin="0,3,12,0"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>

    <TabControl Grid.Row="2" x:Name="ModuleTabs" Background="{StaticResource Panel}" BorderBrush="#3A372A">
      <TabItem Header="DUNGEON SCANNER">
        <Grid x:Name="ScannerModulePanel" Margin="16">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Background="#151815" BorderBrush="#3A372A" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Daggerfall ARENA2 folder" Foreground="{StaticResource Muted}"/>
                <TextBox x:Name="PathBox" Margin="0,5,12,0" Padding="7,5"/>
              </StackPanel>
              <Button Grid.Column="1" Content="CHOOSE FOLDER" Click="ChooseFolder_Click" VerticalAlignment="Bottom"/>
            </Grid>
          </Border>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="285"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="#151815" BorderBrush="#3A372A" BorderThickness="1" CornerRadius="6" Padding="16">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Text="LOOT SEARCH" Foreground="{StaticResource Brass}" FontWeight="Bold"/>
                  <Label Content="Loot category"/><ComboBox x:Name="CategoryBox" SelectionChanged="CategoryBox_SelectionChanged"/>
                  <Label x:Name="ItemLabel" Content="Specific item"/><ComboBox x:Name="ItemBox"/>
                  <Label x:Name="EnchantmentLabel" Content="Enchantment" Visibility="Collapsed"/><ComboBox x:Name="EnchantmentBox" Visibility="Collapsed"/>
                  <Label Content="Material"/><ComboBox x:Name="MaterialBox"/>
                  <Label Content="Character level"/>
                  <DockPanel><TextBlock x:Name="LevelText" Text="10" Width="30" Foreground="{StaticResource Brass}" FontSize="16"/><Slider x:Name="LevelSlider" Minimum="1" Maximum="30" Value="10" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="LevelSlider_ValueChanged"/></DockPanel>
                  <Separator Margin="0,15" Background="#3A372A"/>
                  <TextBlock Text="SCANNER FILTERS" Foreground="{StaticResource Brass}" FontWeight="Bold"/>
                  <Label Content="Region"/><ComboBox x:Name="RegionBox"/>
                  <CheckBox x:Name="LiveOnly" Content="Confirmed live dungeons only" IsChecked="True" Click="ScannerFilter_Click" Margin="0,13,0,7"/>
                  <CheckBox x:Name="DiscoveredOnly" Content="Only discovered classic locations" Click="ScannerFilter_Click" Margin="0,0,0,12"/>
                  <Button Content="CONNECT LIVE DFO" Click="ConnectDfo_Click" Margin="0,0,0,8"/>
                  <Button Content="REFRESH RESULTS" Click="Find_Click"/>
                  <TextBlock x:Name="BridgeStatus" Text="Scanner is starting…" Foreground="#E6C77E" Margin="0,12,0,0" TextWrapping="Wrap"/>
                </StackPanel>
              </ScrollViewer>
            </Border>
            <Grid Grid.Column="2">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Border Background="#242219" BorderBrush="#6A5730" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock x:Name="BestLabel" Text="NEAREST CONFIRMED DUNGEON" Foreground="{StaticResource Brass}" FontSize="12" FontWeight="Bold"/>
                    <TextBlock x:Name="BestName" Text="Connect DFO to begin scanning" FontFamily="Georgia" FontSize="23" Margin="0,3,0,2"/>
                    <TextBlock x:Name="BestDetails" Foreground="{StaticResource Muted}"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="DISTANCE / LOOT CHANCE" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="BestChance" Text="—" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Brass}" HorizontalAlignment="Right"/>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Grid.Row="1" Background="#151815" BorderBrush="#3A372A" BorderThickness="1" CornerRadius="6" Padding="9" Margin="0,0,0,9">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="Dungeon name" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <TextBox x:Name="DungeonSearchBox" Grid.Column="1" TextChanged="DungeonSearchBox_TextChanged" Padding="7,4"/>
                  <Button Grid.Column="2" Content="CLEAR" Click="ClearSearch_Click" Margin="8,0,0,0" Padding="12,5"/>
                </Grid>
              </Border>
              <Border Grid.Row="2" Background="#151815" BorderBrush="#3A372A" BorderThickness="1" CornerRadius="6" Padding="1">
                <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          GridLinesVisibility="Horizontal" Background="#151815" Foreground="{StaticResource Ink}"
                          RowBackground="#171914" AlternatingRowBackground="#1D201A" BorderThickness="0"
                          ColumnHeaderHeight="36" RowHeight="32">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="38"/>
                    <DataGridTextColumn Header="Dungeon" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="Distance" Binding="{Binding Distance}" Width="78"/>
                    <DataGridTextColumn Header="Dir" Binding="{Binding Direction}" Width="42"/>
                    <DataGridTextColumn Header="Region" Binding="{Binding Region}" Width="1.1*"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding DungeonType}" Width="1.05*"/>
                    <DataGridTextColumn Header="Tier" Binding="{Binding Tier}" Width="62"/>
                    <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="62"/>
                    <DataGridTextColumn Header="Blocks" Binding="{Binding Blocks}" Width="54"/>
                    <DataGridTextColumn Header="Map X, Y" Binding="{Binding Coordinates}" Width="80"/>
                    <DataGridTextColumn Header="Loot" Binding="{Binding Chance}" Width="72"/>
                  </DataGrid.Columns>
                </DataGrid>
              </Border>
            </Grid>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="HOTBAR &amp; ACTIVITY">
        <Grid x:Name="HotbarModulePanel" Margin="18">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Padding="16" CornerRadius="7" Background="#151815" BorderBrush="#4A422C" BorderThickness="1">
            <StackPanel>
              <TextBlock x:Name="StatusTitle" FontSize="19" FontWeight="SemiBold" Text="Ready"/>
              <TextBlock x:Name="StatusDetail" Margin="0,4,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                         Text="Enabled modules will start when you launch DFO."/>
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Margin="0,14" Padding="12" CornerRadius="6" Background="#111411" BorderBrush="#32372F" BorderThickness="1">
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
              <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="12" Foreground="#C7D0BF" TextWrapping="Wrap"/>
            </ScrollViewer>
          </Border>
          <TextBlock Grid.Row="2" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                     Text="Hotbar: bind Previous/Next Hotbar Page in DFO Settings › Controls. Scanner: live rows are confirmed by the running DFO client and sorted closest first."/>
        </Grid>
      </TabItem>
    </TabControl>

    <TextBlock Grid.Row="3" x:Name="DataStatus" Margin="0,10,0,0" Foreground="{StaticResource Muted}"
               Text="Choose which modules you want, then launch DFO."/>
  </Grid>
</Window>

